# apps/storefront/.env.example

# Copy to .env.local and adjust for your environment.
# Provisioned automatically by scripts/prepare-env.mjs (`pnpm dev` / `pnpm setup`).

# Base URL of the storefront API. In development this is the real Express API
# (@clothing-line-project/api `dev`, default PORT=5000). The Prism mock runs on
# 4010 via `pnpm --filter @clothing-line-project/api dev:mock` — point at it only
# when you explicitly want the mock.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Default storefront context provisioned by the API's forward-only seed
# migration 0019 (`reg-storefront` = NGN region, 7.5% VAT, Paystack/Shipbubble;
# `channel-storefront` = default storefront sales channel). Required to
# initialize cart sessions (`POST /store/carts`). Kept in sync with
# scripts/prepare-env.mjs.
NEXT_PUBLIC_DEFAULT_REGION_ID=reg-storefront
NEXT_PUBLIC_DEFAULT_SALES_CHANNEL_ID=channel-storefront

# ISO-4217 currency of the default storefront region (display-only formatting;
# the frontend never converts or prices — all amounts come from the API in
# minor units). Kept in sync with scripts/prepare-env.mjs.
NEXT_PUBLIC_DEFAULT_REGION_CURRENCY=NGN
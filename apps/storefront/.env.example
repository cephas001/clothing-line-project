# apps/storefront/.env.example

# Copy to .env.local and adjust for your environment.
# Provisioned automatically by scripts/prepare-env.mjs (`pnpm dev` / `pnpm setup`).

# Base URL of the storefront API. In development this is the real Express API
# (@clothing-line-project/api `dev`, default PORT=5000). The Prism mock runs on
# 4010 via `pnpm --filter @clothing-line-project/api dev:mock` — point at it only
# when you explicitly want the mock.
NEXT_PUBLIC_API_URL=http://localhost:5000
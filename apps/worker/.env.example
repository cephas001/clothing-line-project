# apps/worker/.env.example

# Copy to apps/worker/.env and adjust. The worker reuses the shared
# @clothing-line-project/api configuration modules, which read the SAME
# environment variables as apps/api/.env.example — see that file for the
# full list. A worker process must at least provide:
#
#   DATABASE_URL  (required by the shared Kysely connection module)
#   JWT_SECRET    (required by the shared loadAppConfig; no default)
#   REDIS_URL     (optional, defaults to redis://localhost:6379)
#
# When running both processes locally, the API and the worker share the same
# Postgres and Redis instances, so they can point at identical values.

# --- Required ---
DATABASE_URL=postgres://{USERNAME}:{PASSWORD}@localhost:5433/commerce_db
JWT_SECRET=replace-with-a-long-random-secret

# --- Optional ---
#REDIS_URL=redis://localhost:6379
#LOG_LEVEL=info

# --- OpenTelemetry ---
# The shared instrumentation module reads these too. The worker process can set
# its own service name so traces are attributable to the worker runtime.
#OTEL_ENABLED=true
#OTEL_SERVICE_NAME=@clothing-line-project/worker
#OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

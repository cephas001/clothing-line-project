{
  "name": "@clothing-line-project/api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "prism mock -d openapi.yaml -p 4010",
    "dev:express": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "tsx src/infrastructure/database/migrations/migrate.ts",
    "db:migrate:up": "tsx src/infrastructure/database/migrations/migrate.ts -- --up",
    "db:migrate:down": "tsx src/infrastructure/database/migrations/migrate.ts -- --down",
    "db:migrate:list": "tsx src/infrastructure/database/migrations/migrate.ts -- --list"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@stoplight/prism-cli": "^5.16.0",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.20.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/yamljs": "^0.2.34",
    "tsx": "^4.23.5"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "kysely": "^0.29.4",
    "pg": "^8.22.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.0",
    "yamljs": "^0.3.0"
  },
  "imports": {
    "#domain/*": "./dist/domain/*.js",
    "#use-cases/*": "./dist/use-cases/*.js",
    "#infrastructure/*": "./dist/infrastructure/*.js",
    "#adapters/*": "./dist/adapters/*.js"
  }
}

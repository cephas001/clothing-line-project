{
  "name": "@clothing-line-project/api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:mock": "prism mock -d openapi.yaml -p 4010",
    "dev:express": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "test": "tsx tests/run.ts",
    "db:test": "tsx tests/db/run.ts",
    "db:migrate": "tsx src/infrastructure/database/migrations/migrate.ts",
    "db:migrate:up": "tsx src/infrastructure/database/migrations/migrate.ts -- --up",
    "db:migrate:down": "tsx src/infrastructure/database/migrations/migrate.ts -- --down",
    "db:migrate:list": "tsx src/infrastructure/database/migrations/migrate.ts -- --list"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@stoplight/prism-cli": "^5.16.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.20.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/yamljs": "^0.2.34",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.5"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation-express": "^0.69.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/instrumentation-pg": "^0.73.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.0.10",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "import-in-the-middle": "^3.3.3",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "kysely": "^0.29.4",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.0",
    "yamljs": "^0.3.0"
  },
  "imports": {
    "#domain/*": "./src/domain/*.ts",
    "#use-cases/*": "./src/use-cases/*.ts",
    "#infrastructure/*": "./src/infrastructure/*.ts",
    "#adapters/*": "./src/adapters/*.ts"
  }

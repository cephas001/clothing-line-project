# Copy to `.env` and adjust for your environment.
# Loaded by dotenv (see src/infrastructure/database/kysely.ts and
# src/infrastructure/observability/instrumentation.ts).
# Remove the {} as this as just placeholders
DATABASE_URL=postgres://{USERNAME}:{PASSWORD}@localhost:5433/commerce_db
PORT=5000

# -----------------------------------------------------------------------------
# Token service (JWT + Redis session revocation)
# -----------------------------------------------------------------------------

# HMAC signing secret for JWT auth and password-reset tokens. REQUIRED — the
# token service fails at construction if this is empty. Use a long random
# string (e.g. `openssl rand -hex 32`). NEVER commit a real secret here.
#JWT_SECRET=

# Default lifetime for auth tokens (string or seconds, e.g. "1h" or 3600).
# Default: 1h
#JWT_EXPIRES_IN=1h

# Redis connection used by the session-revocation / token denylist service.
# Default: redis://localhost:6379
#REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Product read cache (read-through Redis decorator over IProductReadRepository)
# -----------------------------------------------------------------------------

# TTL in seconds for product read cache entries. A SHORT TTL is intentional:
# this is a coherence window for a cache whose only correctness cost is
# serving a slightly stale catalog row. The authoritative source for every
# financial decision (checkout price, tax, shipping, promotions, inventory
# reservation, payment amount) is Postgres — never this cache.
# Default: 60
#PRODUCT_CACHE_TTL_SECONDS=60

# -----------------------------------------------------------------------------
# Paystack payment gateway (used by InitializePaymentSessionUseCase and
# ProcessOrderSwapVarianceUseCase). OPTIONAL for local development: when the
# secret key is absent, the Paystack adapter is not constructed and the payment
# use cases are reported as unwired. NEVER commit a real secret here.
# -----------------------------------------------------------------------------

# Paystack secret key. When present, the API runtime builds the Paystack
# adapter (fails at construction if empty/invalid). Use a test key for dev.
#PAYSTACK_SECRET_KEY=

# Paystack webhook signature secret. When present, the payment webhook endpoint
# (/store/payments/webhook) is mounted and every incoming request is verified
# against the HMAC-SHA512 signature Paystack sends in the `x-paystack-signature`
# header, computed over the RAW request bytes with THIS value.
#
# This is a DISTINCT secret from PAYSTACK_SECRET_KEY — it is Paystack's
# dedicated `webhook_secret` (found in Dashboard -> Settings -> API Keys and
# Webhooks). NEVER set it to the same value as the API secret key, and never
# reuse the API secret key for signature verification. When absent, the webhook
# endpoint is not mounted. NEVER commit a real secret here.
#PAYSTACK_WEBHOOK_SECRET=

# Paystack API base URL. HTTPS is enforced by the adapter.
# Default: https://api.paystack.co
#PAYSTACK_BASE_URL=https://api.paystack.co

# Per-request Paystack timeout in milliseconds.
# Default: 10000
#PAYSTACK_TIMEOUT_MS=10000

# -----------------------------------------------------------------------------
# Shipbubble logistics provider (used by RetrieveDynamicShippingQuotesUseCase,
# DispatchOrderFulfillmentUseCase, InitiateReturnAuthorizationUseCase and
# ProcessFraudAlertEventUseCase). OPTIONAL for local development: when the API
# key is absent, the Shipbubble adapter is not constructed and the logistics use
# cases are reported as unwired. When the API key IS present, the sender address
# and package category below are REQUIRED and the API runtime fails fast if they
# are missing. NEVER commit a real key here.
# -----------------------------------------------------------------------------

# Shipbubble API key (test keys start with `sb_sandbox_`, live keys with
# `sb_prod_`). When present, the API runtime builds the Shipbubble adapter.
# HTTPS is enforced; the key is sent via `Authorization: Bearer <key>`.
#SHIPBUBBLE_API_KEY=

# Shipbubble webhook signature secret. When present, the logistics webhook
# endpoint (/store/webhooks/shipbubble) is mounted and every incoming request
# is verified against the HMAC-SHA512 signature Shipbubble sends in the
# `x-shipbubble-signature` header, computed over the RAW request bytes with
# THIS value.
#
# This is a DISTINCT secret from SHIPBUBBLE_API_KEY — it is Shipbubble's
# dedicated webhook signing secret. NEVER set it to the same value as the API
# key, and never reuse the API key for signature verification. There is NO
# default; when absent, the webhook endpoint is not mounted. NEVER commit a
# real secret here.
#SHIPBUBBLE_WEBHOOK_SECRET=

# Shipbubble API base URL. HTTPS is enforced by the adapter.
# Default: https://api.shipbubble.com
#SHIPBUBBLE_BASE_URL=https://api.shipbubble.com

# Per-request Shipbubble timeout in milliseconds.
# Default: 10000
#SHIPBUBBLE_TIMEOUT_MS=10000

# Verified sender/origin address (JSON). Shipbubble's rates API requires a
# sender_address_code, so the adapter validates this origin once and caches the
# returned address code. REQUIRED when SHIPBUBBLE_API_KEY is set.
#SHIPBUBBLE_SENDER_ADDRESS={"name":"Clothing Line","email":"orders@example.com","phone":"+2348000000000","address":"Victoria Island, Lagos, Nigeria"}

# Shipbubble package item category id (see Shipbubble's Package Categories API).
# REQUIRED when SHIPBUBBLE_API_KEY is set.
#SHIPBUBBLE_PACKAGE_CATEGORY_ID=1

# Fallback per-item weight in kilograms used when a cart line item's metadata
# does not carry `weightKg`.
# Default: 1
#SHIPBUBBLE_DEFAULT_ITEM_WEIGHT_KG=1

# Fallback package dimensions in centimetres (JSON) used because the application
# contract carries no parcel dimensions.
# Default: {"length":10,"width":10,"height":10}
#SHIPBUBBLE_DEFAULT_PACKAGE_DIMENSIONS={"length":10,"width":10,"height":10}

# -----------------------------------------------------------------------------
# Notifications (used by InitiatePasswordResetUseCase, ApproveB2BQuoteUseCase,
# GenerateDraftOrderUseCase, and the L8 outbox intents). OPTIONAL for local
# development: when the API key is absent, the notification adapter is not
# constructed and the notification intents are reported as unwired. When the
# API key IS present, NOTIFICATION_FROM_EMAIL below is REQUIRED and the API
# runtime fails fast if it is missing. NEVER commit a real key here.
# -----------------------------------------------------------------------------

# Notification provider. Only "resend" is supported today; an unknown explicit
# value fails fast at startup.
# Default: resend
#NOTIFICATION_PROVIDER=resend

# Resend API key (test keys start with `re_`, live keys with `re_`). When
# present, the API runtime builds the Resend adapter (fail-closed at
# construction). HTTPS is enforced; the key is sent via `Authorization: Bearer
# <key>` and is never logged.
#NOTIFICATION_API_KEY=

# Authoritative sender address for every notification email. REQUIRED when
# NOTIFICATION_API_KEY is set; the runtime fails fast if it is missing.
#NOTIFICATION_FROM_EMAIL=no-reply@example.com

# Optional sender display name.
#NOTIFICATION_FROM_NAME=Clothing Line

# Notification provider API base URL. HTTPS is enforced by the adapter.
# Default: https://api.resend.com
#NOTIFICATION_BASE_URL=https://api.resend.com

# Per-request notification timeout in milliseconds.
# Default: 10000
#NOTIFICATION_TIMEOUT_MS=10000

# Base URL used to build the single-use password-reset link in the
# password-reset email (e.g. "https://shop.example.com/reset-password?token=").
# When absent, the reset email renders the raw token instead of a link.
#NOTIFICATION_PASSWORD_RESET_URL=https://shop.example.com/reset-password?token=

# -----------------------------------------------------------------------------
# OpenTelemetry (distributed tracing) — all variables are OPTIONAL for local
# development. The observability layer owns reading these; no application or
# domain code touches them. See src/infrastructure/observability/config.ts.
# -----------------------------------------------------------------------------

# Master switch. Set to "false" to run without any tracing.
# Default: true
OTEL_ENABLED=true

# Service identity, recorded on every exported span as Resource attributes.
# Defaults: clothing-line-api / (npm package version) / development
#OTEL_SERVICE_NAME=clothing-line-api
#OTEL_SERVICE_VERSION=1.0.0
#OTEL_DEPLOYMENT_ENVIRONMENT=development

# OTLP/HTTP collector endpoint. Default: http://localhost:4318 (local collector).
# Leave unset for local development when no collector is running.
#OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Comma-separated `key=value` headers sent with each export, e.g. an auth token.
# NEVER commit real credentials here — provide them via your environment.
#OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer xxxxx,Other=value

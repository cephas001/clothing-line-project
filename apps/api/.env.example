# Copy to `.env` and adjust for your environment.
# Loaded by dotenv (see src/infrastructure/database/kysely.ts and
# src/infrastructure/observability/instrumentation.ts).
# Remove the {} as this as just placeholders
DATABASE_URL=postgres://{USERNAME}:{PASSWORD}@localhost:5433/commerce_db
PORT=5000

# -----------------------------------------------------------------------------
# Token service (JWT + Redis session revocation)
# -----------------------------------------------------------------------------

# HMAC signing secret for JWT auth and password-reset tokens. REQUIRED — the
# token service fails at construction if this is empty. Use a long random
# string (e.g. `openssl rand -hex 32`). NEVER commit a real secret here.
#JWT_SECRET=

# Default lifetime for auth tokens (string or seconds, e.g. "1h" or 3600).
# Default: 1h
#JWT_EXPIRES_IN=1h

# Redis connection used by the session-revocation / token denylist service.
# Default: redis://localhost:6379
#REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Paystack payment gateway (used by InitializePaymentSessionUseCase and
# ProcessOrderSwapVarianceUseCase). OPTIONAL for local development: when the
# secret key is absent, the Paystack adapter is not constructed and the payment
# use cases are reported as unwired. NEVER commit a real secret here.
# -----------------------------------------------------------------------------

# Paystack secret key. When present, the API runtime builds the Paystack
# adapter (fails at construction if empty/invalid). Use a test key for dev.
#PAYSTACK_SECRET_KEY=

# Paystack webhook signature secret. When present, the payment webhook endpoint
# (/store/payments/webhook) is mounted and every incoming request is verified
# against the HMAC-SHA512 signature Paystack sends in the `x-paystack-signature`
# header, computed over the RAW request bytes with THIS value.
#
# This is a DISTINCT secret from PAYSTACK_SECRET_KEY — it is Paystack's
# dedicated `webhook_secret` (found in Dashboard -> Settings -> API Keys and
# Webhooks). NEVER set it to the same value as the API secret key, and never
# reuse the API secret key for signature verification. When absent, the webhook
# endpoint is not mounted. NEVER commit a real secret here.
#PAYSTACK_WEBHOOK_SECRET=

# Paystack API base URL. HTTPS is enforced by the adapter.
# Default: https://api.paystack.co
#PAYSTACK_BASE_URL=https://api.paystack.co

# Per-request Paystack timeout in milliseconds.
# Default: 10000
#PAYSTACK_TIMEOUT_MS=10000

# -----------------------------------------------------------------------------
# OpenTelemetry (distributed tracing) — all variables are OPTIONAL for local
# development. The observability layer owns reading these; no application or
# domain code touches them. See src/infrastructure/observability/config.ts.
# -----------------------------------------------------------------------------

# Master switch. Set to "false" to run without any tracing.
# Default: true
OTEL_ENABLED=true

# Service identity, recorded on every exported span as Resource attributes.
# Defaults: clothing-line-api / (npm package version) / development
#OTEL_SERVICE_NAME=clothing-line-api
#OTEL_SERVICE_VERSION=1.0.0
#OTEL_DEPLOYMENT_ENVIRONMENT=development

# OTLP/HTTP collector endpoint. Default: http://localhost:4318 (local collector).
# Leave unset for local development when no collector is running.
#OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Comma-separated `key=value` headers sent with each export, e.g. an auth token.
# NEVER commit real credentials here — provide them via your environment.
#OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer xxxxx,Other=value
